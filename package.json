{
  "name": "base_framework",
  "version": "1.0.0",
  "description": "base cypress framework",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "percy:test": "npx percy exec -- cypress run --spec 'cypress/e2e/visual-testing.cy.js' ",
    "as": "cypress-image-diff-html-report generate --rf html-report/cypress_visual_report.json",
    "prepare": "husky"
  },
  "author": "Raptor Team",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@percy/cli": "^1.26.0",
    "@percy/cypress": "^3.1.2",
    "@shelex/cypress-allure-plugin": "^2.40.0",
    "@types/cypress": "^1.1.3",
    "cypress": "^13.17.0",
    "cypress-image-diff-html-report": "^2.0.2",
    "eslint": "^9.27.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "playwright-webkit": "1.34",
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "cypress-image-diff-js": "^2.1.2",
    "scroll-to-bottomjs": "^1.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
